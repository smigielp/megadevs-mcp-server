ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
PORT=3000
# Public https base URL (on Railway it falls back to https://$RAILWAY_PUBLIC_DOMAIN)
BASE_URL=https://megadevs-mcp-server-production.up.railway.app
# Static owner token for your own harness (Authorization: Bearer ...)
AUTH_TOKEN=your_secret_token_here
# Password typed on the OAuth consent page to let a client in (defaults to AUTH_TOKEN)
OWNER_PASSWORD=your_consent_password_here
# Where SQLite and uploads live; point at a persistent volume in production (e.g. /data)
DATA_DIR=./data
